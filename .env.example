# Sao chép thành `.env` và chỉnh giá trị. File `.env` không commit (chứa bí mật).
# Hoặc export các biến này trên server / đặt trong Docker / systemd.

SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/enflow

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/EnFlow
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# HS256: chuỗi UTF-8 dài tối thiểu 32 ký tự (ứng dụng kiểm tra trong JwtService)
ENFLOW_JWT_SECRET=thay-bang-chuoi-bi-mat-du-dai-toi-thieu-32-ky-tu
ENFLOW_JWT_EXPIRATION_MS=86400000

# FE gọi API cross-origin (CORS). Một origin hoặc nhiều origin cách nhau bằng dấu phẩy (không khoảng thừa sau dấu phẩy hoặc đã trim).
# ENFLOW_CORS_ALLOWED_ORIGINS=https://your-app.com,https://www.your-app.com

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
